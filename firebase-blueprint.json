{
  "entities": {
    "Progress": {
      "title": "Progress",
      "description": "User learning progress, including uploaded document, mode, and chat messages",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "documentContent": { "type": "string" },
        "appMode": { "type": "string" },
        "messages": { "type": "array" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "documentContent", "appMode", "messages"]
    }
  },
  "firestore": {
    "/progress/{uid}": {
      "schema": "#/entities/Progress",
      "description": "Stores progress for each user"
    }
  }
}
