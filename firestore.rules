rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidProgress(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'documentContent', 'appMode', 'messages', 'updatedAt']) 
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.name is string && data.name.size() <= 256
        && data.documentContent is string
        && data.appMode is string && data.appMode.size() <= 64
        && data.messages is list
        && data.updatedAt is number;
    }

    match /progress/{uid} {
      allow read: if true;
      
      allow write: if isValidProgress(request.resource.data)
        && request.resource.data.uid == uid;
    }
  }
}
